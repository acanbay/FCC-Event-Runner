#!/usr/bin/env python3

# Author: Ali Can Canbay <acanbay@ankara.edu.tr>

"""Command-line entry point for FCC Event Runner."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path


PROJECT_DIRECTORY = Path(__file__).resolve().parents[1]
RUNNER_DIRECTORY = PROJECT_DIRECTORY / "runner"

sys.path.insert(0, str(RUNNER_DIRECTORY))

from workflow import WorkflowOptions, run_fcc_workflow  # noqa: E402


def print_banner() -> None:
    print(
        """
======================================================================
 FCC Event Runner
 MadGraph5 -> Pythia8 -> Delphes -> EDM4hep

 Ali Can Canbay <acanbay@ankara.edu.tr>
======================================================================
""".strip()
    )
    print()


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Run a MadGraph5, Pythia8 and Delphes event production workflow."
        )
    )

    parser.add_argument(
        "config",
        type=Path,
        help="Path to the production YAML file.",
    )

    mode = parser.add_mutually_exclusive_group()

    mode.add_argument(
        "--prepare",
        action="store_true",
        help=(
            "Check the Key4hep environment and prepare the LHAPDF set "
            "without generating events."
        ),
    )

    mode.add_argument(
        "--dry-run",
        action="store_true",
        help="Show the resolved production summary without running anything.",
    )

    parser.add_argument(
        "--confirm",
        action="store_true",
        help="Wait for Enter before starting the workflow.",
    )

    parser.add_argument(
        "--overwrite",
        action="store_true",
        help="Replace an existing EDM4hep output after successful validation.",
    )

    parser.add_argument(
        "--keep-lhe",
        action="store_true",
        help="Keep the generated LHE file as a compressed output.",
    )

    parser.add_argument(
        "--keep-work",
        action="store_true",
        help="Keep the MadGraph process directory after a successful run.",
    )

    parser.add_argument(
        "--lhapdf-dir",
        type=Path,
        default=(
            Path.home()
            / ".local"
            / "share"
            / "fcc-event-runner"
            / "lhapdf"
        ),
        help="Writable directory used for missing LHAPDF sets.",
    )

    return parser.parse_args()


def main() -> int:
    arguments = parse_arguments()
    print_banner()

    options = WorkflowOptions(
        config_file=arguments.config,
        prepare=arguments.prepare,
        dry_run=arguments.dry_run,
        confirm=arguments.confirm,
        overwrite=arguments.overwrite,
        keep_lhe=arguments.keep_lhe,
        keep_work=arguments.keep_work,
        lhapdf_directory=arguments.lhapdf_dir,
    )

    return run_fcc_workflow(options)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\nProduction cancelled by user.", file=sys.stderr)
        raise SystemExit(130)
    except (RuntimeError, ValueError, OSError) as error:
        print(f"\nERROR: {error}", file=sys.stderr)
        raise SystemExit(1)