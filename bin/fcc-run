#!/usr/bin/env python3

# Author: Ali Can Canbay <acanbay@ankara.edu.tr>

"""Command-line interface for FCC Event Runner."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path


PROJECT_DIR = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PROJECT_DIR / "runner"))

from workflow import WorkflowOptions, run_fcc_workflow  # noqa: E402


def arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Run MG5, Pythia8 and Delphes and write EDM4hep output."
    )
    parser.add_argument("config", type=Path, help="Production YAML file.")

    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--dry-run",
        action="store_true",
        help="Show the production without running it.",
    )
    mode.add_argument(
        "--prepare",
        action="store_true",
        help="Install a missing PDF without generating events.",
    )

    parser.add_argument(
        "--confirm",
        action="store_true",
        help="Wait for Enter before starting.",
    )
    parser.add_argument(
        "--overwrite",
        action="store_true",
        help="Replace an existing validated output.",
    )
    parser.add_argument(
        "--keep-lhe",
        action="store_true",
        help="Keep the compressed LHE output.",
    )
    parser.add_argument(
        "--keep-work",
        action="store_true",
        help="Keep the MadGraph directory after success.",
    )
    parser.add_argument(
        "--lhapdf-dir",
        type=Path,
        default=(
            Path.home()
            / ".local"
            / "share"
            / "fcc-event-runner"
            / "lhapdf"
        ),
        help="Writable LHAPDF cache directory.",
    )
    return parser.parse_args()


def main() -> int:
    values = arguments()
    print(
        "======================================================================\n"
        " FCC Event Runner\n"
        " MadGraph5 -> Pythia8 -> Delphes -> EDM4hep\n\n"
        " Ali Can Canbay <acanbay@ankara.edu.tr>\n"
        "======================================================================\n"
    )
    return run_fcc_workflow(
        WorkflowOptions(
            config_file=values.config,
            prepare=values.prepare,
            dry_run=values.dry_run,
            confirm=values.confirm,
            overwrite=values.overwrite,
            keep_lhe=values.keep_lhe,
            keep_work=values.keep_work,
            lhapdf_directory=values.lhapdf_dir,
        )
    )


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\nProduction cancelled.", file=sys.stderr)
        raise SystemExit(130)
    except (RuntimeError, ValueError, OSError) as error:
        print(f"\nERROR: {error}", file=sys.stderr)
        raise SystemExit(1)